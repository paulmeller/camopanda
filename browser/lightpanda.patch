+test "Config: profile validation keeps default restriction and rejects injection" {
+    try std.testing.expectError(error.Reserved, validateProfileUserAgent("Mozilla/5.0", false));
+    try validateProfileUserAgent("Mozilla/5.0", true);
+    try std.testing.expectError(error.NonPrintable, validateProfileUserAgent("Mozilla/5.0\r\nInjected: yes", true));
+}
+
+test "Config: header profile flags work in either argument order" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    for ([_][5][*:0]const u8{
+        .{ "lightpanda", "serve", "--user-agent", "Mozilla/5.0", "--camopanda-header-profiles" },
+        .{ "lightpanda", "serve", "--camopanda-header-profiles", "--user-agent", "Mozilla/5.0" },
+    }) |argv| {
+        const config = try parseArgs(arena.allocator(), .{ .vector = &argv });
+        try std.testing.expect(config.headerProfiles());
+        try std.testing.expectEqualStrings("Mozilla/5.0", config.http_headers.user_agent);
+    }
+}
